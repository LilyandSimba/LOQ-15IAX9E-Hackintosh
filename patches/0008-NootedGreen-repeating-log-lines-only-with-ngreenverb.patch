@@ -7780,7 +7787,7 @@ void *Gen11::IGHardwareContextwithOptions(void *task, const void *params, uint8_
 	cb->writeReg32(0x101008, 0x1);
 	for (int i = 0; i < 96; i++) buf[i] = ap[i];
 
-	if (v508Count <= 4) {
