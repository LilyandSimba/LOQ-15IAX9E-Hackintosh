From f56126f34f88302489a92943109b3a28138b3e60 Mon Sep 17 00:00:00 2001
From: LilyandSimba <341599777+LilyandSimba@users.noreply.github.com>
Date: Thu, 29 Oct 2026 13:48:43 -0400
Subject: [PATCH 8/8] NootedGreen: repeating log lines only with
 -ngreenverbose; release build option

The lines that keep printing for as long as the GPU runs are now behind
-ngreenverbose: XE-FLIPLOG and the two "XeNG CS" IOLogs in the CS state
worker, V194 (Blit3D ctx changed), V212 (isGpuIdle override), V130, and the
normal-path V508/V509 lines plus the two "XeNG V509" IOLogs. On the working
LOQ boot these were ~7,000 Lilu log lines in the first 4 minutes. One-time
and error-path lines (V509 repair/skip, XE-GMS, XE-AUXA, TOPO, ...) stay on.
No behaviour change: only the log calls are gated.

build-nootedgreen.sh release builds without -DDEBUG=1 and
-DAPPLE_KEXT_ASSERTIONS=1 (DBGLOG compiled out); the default is unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 build-nootedgreen.sh           |  4 +++-
 src/NootedGreen/kern_gen11.cpp | 35 ++++++++++++++++++++--------------
 2 files changed, 24 insertions(+), 15 deletions(-)

diff --git a/build-nootedgreen.sh b/build-nootedgreen.sh
index b6acfdd..06dea13 100644
--- a/build-nootedgreen.sh
+++ b/build-nootedgreen.sh
@@ -1,6 +1,7 @@
 #!/bin/zsh
 # Builds NootedGreen.kext (this fork, src/NootedGreen) without Xcode, using only the Command Line Tools.
 #   zsh build-nootedgreen.sh            -> build/NootedGreen.kext
+#   zsh build-nootedgreen.sh release    -> same, without -DDEBUG/assertions (DBGLOG compiled out)
 # Fetches the build dependencies the first time: acidanthera/MacKernelSDK (git) and the Lilu DEBUG release
 # (headers + plugin_start.cpp). Copy build/NootedGreen.kext into EFI/OC/Kexts.
 set -e
@@ -29,8 +30,9 @@ sed -e "s/\$(PRODUCT_BUNDLE_IDENTIFIER)/$BID/g" -e "s/\$(PRODUCT_NAME:rfc1034ide
 FLAGS=(-arch x86_64 -mkernel -nostdinc -fno-builtin -fno-common -fno-stack-protector
        -mmacosx-version-min=13.0 -mmmx -msse -msse2
        -DKERNEL -DKERNEL_PRIVATE -DDRIVER_PRIVATE -DAPPLE -DNeXT
-       -DDEBUG=1 -DAPPLE_KEXT_ASSERTIONS=1 -DPRODUCT_NAME=$NAME -DMODULE_VERSION=$VER
+       -DPRODUCT_NAME=$NAME -DMODULE_VERSION=$VER
        -isystem $SDK/Headers -I$LILU -O2 -g)
+[[ $1 == release ]] || FLAGS+=(-DDEBUG=1 -DAPPLE_KEXT_ASSERTIONS=1)
 cat > $TMP/info.c <<EOC
 #include <mach/mach_types.h>
 extern kern_return_t ${NAME}_kern_start(kmod_info_t *ki, void *data);
