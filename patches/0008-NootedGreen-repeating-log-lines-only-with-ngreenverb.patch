 extern bool gXeLockRouted;
 void xeFlipStats(uint32_t *queue, uint32_t *complete, uint32_t *irq, uint32_t *timeout);  // xe/fliplog (kern_green.cpp)
+// xe/quiet (29/10): the lines that repeat for as long as the GPU runs (XE-FLIPLOG, XeNG CS, V130/V194/V212/V508/V509 on
+// the normal path) only print with -ngreenverbose. One-time and error-path lines stay on.
+static bool xeVerbose() {
+	static int v = -1;
+	if (v < 0) v = checkKernelArgument("-ngreenverbose") ? 1 : 0;
+	return v == 1;
+}
 // xe/noscansync (29/10): IGAccelSurface::generateSync (only caller: submitSwapFlush) emits a scanline-window wait into the
 // command stream (MI_LOAD_SCAN_LINES + DERRMR unmask + MI_WAIT_FOR_EVENT + synchronousCtxSwitch). On the LOQ (ADL-S) the
 // event never arrives: two boots out of two, the BCS context hung "ELEMENT_SWITCH | WAIT_ON_SCANLINE" at MI_FLUSH_DW,
@@ -497,7 +504,7 @@ static void xeCsStateWorker(thread_call_param_t, thread_call_param_t) {
 		uint32_t sk = gCsbSkipN;
 		if (sk != lastSkip && dumps < 6) { lastSkip = sk; dumps++; xeEvDumpRecent(120, dumps); }
 	}
-	if (tick % 8 == 0) for (int i = 0; i < 4; i++) {
+	if (tick % 8 == 0 && xeVerbose()) for (int i = 0; i < 4; i++) {
