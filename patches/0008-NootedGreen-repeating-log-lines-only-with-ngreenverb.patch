+	if (xeVerbose()) IOLog("XeNG V509 init lrca=%x DW0..3=%08x %08x %08x %08x DW80=%08x %s\n", lrcaGpuVa, (uint32_t)ap[0], (uint32_t)ap[1],
 		  (uint32_t)ap[2], (uint32_t)ap[3], (uint32_t)ap[80], ap[1] == 0x00ffffff ? "REPARA" : "ok");
 	if (ap[1] != 0x00ffffff) {
 		// Already has a valid LRI header — restoreFromSafeImage gave us a good image.
-		SYSLOG("ngreen", "V509: DW1=%08x (valid), no repair needed", (uint32_t)ap[1]);
+		if (xeVerbose()) SYSLOG("ngreen", "V509: DW1=%08x (valid), no repair needed", (uint32_t)ap[1]);
 	} else {
