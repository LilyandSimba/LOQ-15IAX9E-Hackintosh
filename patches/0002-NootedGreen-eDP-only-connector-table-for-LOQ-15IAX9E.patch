From 44ed1f0a3a6477a3a58dc5f681b5347ea11fdfc0 Mon Sep 17 00:00:00 2001
From: LilyandSimba <341599777+LilyandSimba@users.noreply.github.com>
Date: Wed, 28 Oct 2026 22:37:31 -0400
Subject: [PATCH 2/8] NootedGreen: eDP-only connector table for LOQ 15IAX9E
 (ADL-S)

pinfo[1] carried the XPS 13 Plus layout, whose connector 1 is a
USB-C/Thunderbolt DP port on TC1/DDI-D. On the LOQ the iGPU only
drives eDP-1 (HDMI is wired to the NVIDIA GPU), and ADL-S has no
Type-C/FIA ports at all (Linux i915 intel_phy_is_tc() is false for
it). Make connector 1 a dummy so the TGL framebuffer only brings up
eDP on DDI-A.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/NootedGreen/kern_gen11.cpp | 14 ++++----------
 1 file changed, 4 insertions(+), 10 deletions(-)

diff --git a/src/NootedGreen/kern_gen11.cpp b/src/NootedGreen/kern_gen11.cpp
index 4d77067..df241ed 100755
--- a/src/NootedGreen/kern_gen11.cpp
+++ b/src/NootedGreen/kern_gen11.cpp
@@ -4607,19 +4607,13 @@ uint64_t Gen11::getOSInformation(AppleIntel::AppleIntelBaseController *that)
 		pinfo[1].connectors[0].type  = ConnectorLVDS;
 		pinfo[1].connectors[0].flags = 0x8 | 0x10;
 
-		// Connector 1: external USB-C/Thunderbolt DP (TC1/DDI-D), pipe 2
-		pinfo[1].connectors[1].index = 1;
-		pinfo[1].connectors[1].busId = 1;
-		pinfo[1].connectors[1].pipe  = 2;
-		pinfo[1].connectors[1].pad   = 0;
-		pinfo[1].connectors[1].type  = ConnectorDP;
-		pinfo[1].connectors[1].flags = 0x1 | 0x400;
-
-		// Connectors 2-3: Dummy
+		// Connectors 1-3: Dummy. LOQ 15IAX9E (ADL-S, display 12): the iGPU only drives eDP-1, HDMI is on the
+		// NVIDIA GPU, and ADL-S has no Type-C/FIA ports, so the XPS TC1/DDI-D DP connector is not exposed.
+		pinfo[1].connectors[1] = { 1, 1, 1, 0, ConnectorDummy, 0 };
 		pinfo[1].connectors[2] = { 2, 2, 2, 0, ConnectorDummy, 0 };
 		pinfo[1].connectors[3] = { 3, 3, 3, 0, ConnectorDummy, 0 };
 
-		SYSLOG("ngreen", "getOSInformation: patched pinfo[1] for ADL-P (LVDS+HDMI, mobile)");
+		SYSLOG("ngreen", "getOSInformation: patched pinfo[1] for ADL-S (eDP only on DDI-A, mobile)");
 	}
 	return FunctionCast(getOSInformation, callback->ogetOSInformation)(that);
 }
